<mvc:View
    controllerName="apps.dflc.expensemanager.controller.Signup"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page id="signupPage" showHeader="false" backgroundDesign="List" class="loginPage">
        <content>
            <FlexBox
                class="loginAside changePasswordAside"
                height="100%"
                justifyContent="Center"
                alignItems="Center"
            >
                <VBox
                    class="loginCard"
                    alignItems="Center"
                    busy="{account>/busy}"
                    busyIndicatorDelay="0"
                >
                    <HBox alignItems="Center" class="loginBrand sapUiMediumMarginBottom">
                        <Image
                            src="img/logo.svg"
                            width="2.4rem"
                            height="2.4rem"
                            decorative="true"
                            class="loginBrandLogo sapUiSmallMarginEnd"
                        />
                        <Title text="{i18n>brandTitle}" level="H2" titleStyle="H2" class="loginBrandTitle" />
                    </HBox>

                    <Title
                        text="{i18n>signupTitle}"
                        level="H1"
                        titleStyle="H3"
                        wrapping="true"
                        textAlign="Center"
                        class="loginHeadline sapUiTinyMarginBottom"
                    />
                    <Text
                        text="{i18n>signupSubtitle}"
                        textAlign="Center"
                        class="loginSubtitle sapUiMediumMarginBottom"
                    />

                    <VBox width="100%" class="loginForm" visible="{= !${account>/done} }">
                        <MessageStrip
                            text="{account>/error}"
                            type="Error"
                            showIcon="true"
                            visible="{= !!${account>/error} }"
                            class="loginMessage"
                        />
                        <Label text="{i18n>signupName}" labelFor="signupName" required="true" />
                        <Input
                            id="signupName"
                            value="{account>/name}"
                            type="Text"
                            placeholder="{i18n>signupNamePlaceholder}"
                            valueState="{account>/nameState}"
                            valueStateText="{i18n>accountInvalidName}"
                            maxLength="100"
                            submit=".onCreate"
                            width="100%"
                        />
                        <Label text="{i18n>loginEmail}" labelFor="signupEmail" required="true" class="loginLabel" />
                        <Input
                            id="signupEmail"
                            value="{account>/email}"
                            type="Email"
                            placeholder="{i18n>loginEmailPlaceholder}"
                            valueState="{account>/emailState}"
                            valueStateText="{i18n>accountInvalidEmail}"
                            maxLength="256"
                            submit=".onCreate"
                            width="100%"
                        />
                        <Label text="{i18n>loginPassword}" labelFor="signupPassword" required="true" class="loginLabel" />
                        <Input
                            id="signupPassword"
                            value="{account>/password}"
                            type="Password"
                            valueState="{account>/passwordState}"
                            valueStateText="{i18n>changePasswordWeak}"
                            maxLength="256"
                            submit=".onCreate"
                            width="100%"
                        />
                        <Label text="{i18n>changePasswordConfirm}" labelFor="signupConfirm" required="true" class="loginLabel" />
                        <Input
                            id="signupConfirm"
                            value="{account>/confirm}"
                            type="Password"
                            valueState="{account>/confirmState}"
                            valueStateText="{i18n>changePasswordMismatch}"
                            maxLength="256"
                            submit=".onCreate"
                            width="100%"
                        />
                        <Button
                            id="signupButton"
                            text="{i18n>signupButton}"
                            icon="sap-icon://add-employee"
                            press=".onCreate"
                            type="Emphasized"
                            width="100%"
                            class="loginPrimary"
                        />
                    </VBox>

                    <MessageStrip
                        text="{account>/doneMessage}"
                        type="Success"
                        showIcon="true"
                        visible="{account>/done}"
                        class="loginMessage accountDone"
                    />

                    <Link text="{i18n>signupHaveAccount}" press=".onBackToLogin" class="loginLink sapUiSmallMarginTop" />
                </VBox>
            </FlexBox>
        </content>
    </Page>
</mvc:View>
