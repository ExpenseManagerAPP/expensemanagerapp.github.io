<mvc:View
    controllerName="apps.dflc.expensemanager.controller.ResetPassword"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page id="resetPasswordPage" showHeader="false" backgroundDesign="List" class="loginPage">
        <content>
            <FlexBox
                class="loginAside changePasswordAside"
                height="100%"
                justifyContent="Center"
                alignItems="Center"
            >
                <VBox
                    class="loginCard"
                    alignItems="Center"
                    busy="{account>/busy}"
                    busyIndicatorDelay="0"
                >
                    <HBox alignItems="Center" class="loginBrand sapUiMediumMarginBottom">
                        <Image
                            src="img/logo.svg"
                            width="2.4rem"
                            height="2.4rem"
                            decorative="true"
                            class="loginBrandLogo sapUiSmallMarginEnd"
                        />
                        <Title text="{i18n>brandTitle}" level="H2" titleStyle="H2" class="loginBrandTitle" />
                    </HBox>

                    <Title
                        text="{i18n>resetTitle}"
                        level="H1"
                        titleStyle="H3"
                        wrapping="true"
                        textAlign="Center"
                        class="loginHeadline sapUiTinyMarginBottom"
                    />
                    <Text
                        text="{i18n>resetSubtitle}"
                        textAlign="Center"
                        class="loginSubtitle sapUiMediumMarginBottom"
                    />

                    <VBox width="100%" class="loginForm">
                        <MessageStrip
                            text="{account>/error}"
                            type="Error"
                            showIcon="true"
                            visible="{= !!${account>/error} }"
                            class="loginMessage"
                        />
                        <Label text="{i18n>changePasswordNew}" labelFor="resetNewPassword" required="true" />
                        <Input
                            id="resetNewPassword"
                            value="{account>/next}"
                            type="Password"
                            valueState="{account>/nextState}"
                            valueStateText="{i18n>changePasswordWeak}"
                            maxLength="256"
                            submit=".onSave"
                            width="100%"
                        />
                        <Label text="{i18n>changePasswordConfirm}" labelFor="resetConfirmPassword" required="true" class="loginLabel" />
                        <Input
                            id="resetConfirmPassword"
                            value="{account>/confirm}"
                            type="Password"
                            valueState="{account>/confirmState}"
                            valueStateText="{i18n>changePasswordMismatch}"
                            maxLength="256"
                            submit=".onSave"
                            width="100%"
                        />
                        <Button
                            id="resetButton"
                            text="{i18n>resetButton}"
                            icon="sap-icon://locked"
                            press=".onSave"
                            type="Emphasized"
                            width="100%"
                            class="loginPrimary"
                        />
                    </VBox>

                    <Link text="{i18n>forgotBackToLogin}" press=".onBackToLogin" class="loginLink sapUiSmallMarginTop" />
                </VBox>
            </FlexBox>
        </content>
    </Page>
</mvc:View>
