<mvc:View
    controllerName="apps.dflc.expensemanager.controller.ChangePassword"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page id="changePasswordPage" showHeader="false" backgroundDesign="List" class="loginPage">
        <content>
            <FlexBox
                class="loginAside changePasswordAside"
                height="100%"
                justifyContent="Center"
                alignItems="Center"
            >
                <VBox
                    class="loginCard"
                    alignItems="Center"
                    busy="{password>/busy}"
                    busyIndicatorDelay="0"
                >
                    <HBox alignItems="Center" class="loginBrand sapUiMediumMarginBottom">
                        <Image
                            src="img/logo.svg"
                            width="2.4rem"
                            height="2.4rem"
                            decorative="true"
                            class="loginBrandLogo sapUiSmallMarginEnd"
                        />
                        <Title text="{i18n>brandTitle}" level="H2" titleStyle="H2" class="loginBrandTitle" />
                    </HBox>

                    <Title
                        text="{i18n>changePasswordTitle}"
                        level="H1"
                        titleStyle="H3"
                        wrapping="true"
                        textAlign="Center"
                        class="loginHeadline sapUiTinyMarginBottom"
                    />
                    <Text
                        text="{i18n>changePasswordSubtitle}"
                        textAlign="Center"
                        class="loginSubtitle sapUiMediumMarginBottom"
                    />

                    <VBox width="100%" class="loginForm">
                        <MessageStrip
                            text="{password>/error}"
                            type="Error"
                            showIcon="true"
                            visible="{= !!${password>/error} }"
                            class="loginMessage"
                        />
                        <Label text="{i18n>changePasswordCurrent}" labelFor="currentPassword" required="true" />
                        <Input
                            id="currentPassword"
                            value="{password>/current}"
                            type="Password"
                            valueState="{password>/currentState}"
                            valueStateText="{i18n>loginPasswordRequired}"
                            maxLength="256"
                            submit=".onSave"
                            width="100%"
                        />
                        <Label text="{i18n>changePasswordNew}" labelFor="newPassword" required="true" class="loginLabel" />
                        <Input
                            id="newPassword"
                            value="{password>/next}"
                            type="Password"
                            valueState="{password>/nextState}"
                            valueStateText="{i18n>changePasswordWeak}"
                            maxLength="256"
                            submit=".onSave"
                            width="100%"
                        />
                        <Label text="{i18n>changePasswordConfirm}" labelFor="confirmPassword" required="true" class="loginLabel" />
                        <Input
                            id="confirmPassword"
                            value="{password>/confirm}"
                            type="Password"
                            valueState="{password>/confirmState}"
                            valueStateText="{i18n>changePasswordMismatch}"
                            maxLength="256"
                            submit=".onSave"
                            width="100%"
                        />
                        <Button
                            id="changePasswordButton"
                            text="{i18n>changePasswordButton}"
                            icon="sap-icon://locked"
                            press=".onSave"
                            type="Emphasized"
                            width="100%"
                            class="loginPrimary"
                        />
                    </VBox>

                    <Link text="{i18n>changePasswordLogout}" press=".onLogout" class="loginLink sapUiSmallMarginTop" />
                </VBox>
            </FlexBox>
        </content>
    </Page>
</mvc:View>
