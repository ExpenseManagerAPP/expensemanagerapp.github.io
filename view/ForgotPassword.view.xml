<mvc:View
    controllerName="apps.dflc.expensemanager.controller.ForgotPassword"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page id="forgotPasswordPage" showHeader="false" backgroundDesign="List" class="loginPage">
        <content>
            <!-- No celular, o mesmo header da Home: em tela cheia ele continua
                 pela barra de status, na cor da marca. -->
            <HBox class="appHeader" visible="{device>/system/phone}">
                <HBox
                    class="appHeaderInner"
                    alignItems="Center"
                >
                    <Image
                        src="img/logo.svg"
                        width="2.25rem"
                        height="2.25rem"
                        decorative="true"
                        class="brandLogo sapUiSmallMarginEnd"
                    />
                    <Title
                        text="{i18n>brandTitle}"
                        level="H2"
                        class="appHeaderTitle"
                    />
                </HBox>
            </HBox>
            <FlexBox
                class="loginAside changePasswordAside"
                height="100%"
                justifyContent="Center"
                alignItems="Center"
            >
                <VBox
                    class="loginCard"
                    alignItems="Center"
                    busy="{account>/busy}"
                    busyIndicatorDelay="0"
                >
                    <HBox alignItems="Center" class="loginBrand sapUiMediumMarginBottom" visible="{= !${device>/system/phone} }">
                        <Image
                            src="img/logo.svg"
                            width="2.4rem"
                            height="2.4rem"
                            decorative="true"
                            class="loginBrandLogo sapUiSmallMarginEnd"
                        />
                        <Title text="{i18n>brandTitle}" level="H2" titleStyle="H2" class="loginBrandTitle" />
                    </HBox>

                    <Title
                        text="{i18n>forgotTitle}"
                        level="H1"
                        titleStyle="H3"
                        wrapping="true"
                        textAlign="Center"
                        class="loginHeadline sapUiTinyMarginBottom"
                    />
                    <Text
                        text="{i18n>forgotSubtitle}"
                        textAlign="Center"
                        class="loginSubtitle sapUiMediumMarginBottom"
                    />

                    <VBox width="100%" class="loginForm" visible="{= !${account>/done} }">
                        <MessageStrip
                            text="{account>/error}"
                            type="Error"
                            showIcon="true"
                            visible="{= !!${account>/error} }"
                            class="loginMessage"
                        />
                        <Label text="{i18n>loginEmail}" labelFor="forgotEmail" required="true" />
                        <Input
                            id="forgotEmail"
                            value="{account>/email}"
                            type="Email"
                            placeholder="{i18n>loginEmailPlaceholder}"
                            valueState="{account>/emailState}"
                            valueStateText="{i18n>accountInvalidEmail}"
                            maxLength="256"
                            submit=".onSend"
                            width="100%"
                        />
                        <Button
                            id="forgotButton"
                            text="{i18n>forgotButton}"
                            icon="sap-icon://email"
                            press=".onSend"
                            type="Emphasized"
                            width="100%"
                            class="loginPrimary"
                        />
                    </VBox>

                    <MessageStrip
                        text="{account>/doneMessage}"
                        type="Success"
                        showIcon="true"
                        visible="{account>/done}"
                        class="loginMessage accountDone"
                    />

                    <Link text="{i18n>forgotBackToLogin}" press=".onBackToLogin" class="loginLink sapUiSmallMarginTop" />

                    <!-- Só no navegador; some quando o app já está instalado. -->
                    <Button
                        text="{i18n>installAppButton}"
                        icon="sap-icon://download"
                        type="Transparent"
                        width="100%"
                        press=".onInstallApp"
                        visible="{pwa>/canInstall}"
                        class="loginInstall"
                    />
                </VBox>
            </FlexBox>
        </content>
    </Page>
</mvc:View>
